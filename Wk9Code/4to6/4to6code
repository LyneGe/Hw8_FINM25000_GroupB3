{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyM5zTt7gPMhLZhzDQcRaLQr"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt"],"metadata":{"id":"3Tij40WJKI-N","executionInfo":{"status":"ok","timestamp":1786994626621,"user_tz":300,"elapsed":345,"user":{"displayName":"Owakamare Princewill","userId":"11698501470093797192"}}},"execution_count":1,"outputs":[]},{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/gdrive', force_remount=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"DrQfxssuKPxP","executionInfo":{"status":"ok","timestamp":1786994649876,"user_tz":300,"elapsed":3574,"user":{"displayName":"Owakamare Princewill","userId":"11698501470093797192"}},"outputId":"5d157ce3-9ee0-4340-e876-a9a2789f1002"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/gdrive\n"]}]},{"cell_type":"code","source":["FILE = \"/content/gdrive/MyDrive/Code/Wk9/asset_class_etf_data.xlsx\" #CHANGE THIS BASED ON FILE LOCATION\n","\n","ASSETS = [\"SPY\", \"VEA\", \"IEF\", \"HYG\", \"GLD\", \"USO\", \"BTC\"]\n","TRADITIONAL_ASSETS = [\"SPY\", \"VEA\", \"IEF\", \"HYG\", \"GLD\", \"USO\"]\n","\n","ANNUALIZATION = 52\n","WEEKS_IN_3_YEARS = 156\n"],"metadata":{"id":"f2Ts86boKqEU","executionInfo":{"status":"ok","timestamp":1786994705999,"user_tz":300,"elapsed":5,"user":{"displayName":"Owakamare Princewill","userId":"11698501470093797192"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["df = pd.read_excel(FILE, sheet_name=\"excess returns\")\n","df[\"Date\"] = pd.to_datetime(df[\"Date\"])\n","df = df.sort_values(\"Date\").reset_index(drop=True)\n","\n","# Keep only the columns we need\n","df = df[[\"Date\"] + ASSETS]\n","\n","print(\"Data shape:\", df.shape)\n","print(\"\\nFirst few observations:\")\n","print(df.head())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"BorzgyL6KZ-p","executionInfo":{"status":"ok","timestamp":1786994744527,"user_tz":300,"elapsed":121,"user":{"displayName":"Owakamare Princewill","userId":"11698501470093797192"}},"outputId":"d840c065-7595-4e10-9f27-f923ba6c3211"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Data shape: (494, 8)\n","\n","First few observations:\n","        Date       SPY       VEA       IEF       HYG       GLD       USO  \\\n","0 2017-01-13 -0.000886  0.009979  0.002673  0.000850  0.021832 -0.023298   \n","1 2017-01-20 -0.001456 -0.004326 -0.005499 -0.001465  0.007264 -0.001843   \n","2 2017-01-27  0.009926  0.010723 -0.000863  0.004793 -0.013469  0.000969   \n","3 2017-02-03  0.001797  0.005705  0.001041 -0.001303  0.023443  0.012462   \n","4 2017-02-10  0.009281  0.000603  0.003826  0.000390  0.012477 -0.003647   \n","\n","        BTC  \n","0 -0.086877  \n","1  0.086127  \n","2  0.027714  \n","3  0.119953  \n","4 -0.040220  \n"]}]},{"cell_type":"code","source":["def annualized_mean(returns):\n","    \"\"\"\n","    Annualized arithmetic mean of weekly excess returns.\n","    \"\"\"\n","    return returns.mean() * ANNUALIZATION\n","\n","\n","def annualized_volatility(returns):\n","    \"\"\"\n","    Annualized volatility of weekly returns.\n","    \"\"\"\n","    return returns.std() * np.sqrt(ANNUALIZATION)\n","\n","\n","def sharpe_ratio(returns):\n","    \"\"\"\n","    Annualized Sharpe ratio.\n","\n","    Since the data are already excess returns,\n","    risk-free rate = 0 for this calculation.\n","    \"\"\"\n","    vol = annualized_volatility(returns)\n","\n","    if vol == 0:\n","        return np.nan\n","\n","    return annualized_mean(returns) / vol\n","\n","\n","def empirical_var(returns, alpha=0.05):\n","    \"\"\"\n","    Historical/empirical VaR.\n","\n","    Returns VaR as a positive loss number.\n","\n","    Example:\n","        5% quantile = -0.04\n","        VaR = 0.04 = 4%\n","    \"\"\"\n","    return -returns.quantile(alpha)\n","\n","\n","def portfolio_returns(returns, weights):\n","    \"\"\"\n","    Calculate portfolio weekly returns.\n","    \"\"\"\n","    return returns @ weights\n","\n","\n","def portfolio_stats(returns):\n","    \"\"\"\n","    Return annualized mean, volatility, and Sharpe.\n","    \"\"\"\n","    return {\n","        \"Mean\": annualized_mean(returns),\n","        \"Volatility\": annualized_volatility(returns),\n","        \"Sharpe\": sharpe_ratio(returns)\n","    }\n","\n","\n","def tangency_weights(returns):\n","    \"\"\"\n","    Calculate unconstrained tangency portfolio weights.\n","\n","    w = Sigma^-1 mu\n","    then normalize so that weights sum to 1.\n","\n","    Short positions and leverage are allowed.\n","    \"\"\"\n","\n","    mu = returns.mean().values\n","    sigma = returns.cov().values\n","\n","    # Pseudoinverse is numerically safer than regular inverse\n","    sigma_inv = np.linalg.pinv(sigma)\n","\n","    raw_weights = sigma_inv @ mu\n","\n","    # Normalize weights to sum to 1\n","    weights = raw_weights / raw_weights.sum()\n","\n","    return pd.Series(weights, index=returns.columns)\n","\n","\n","def print_stats(name, returns):\n","    \"\"\"\n","    Print portfolio statistics.\n","    \"\"\"\n","    stats = portfolio_stats(returns)\n","\n","    print(f\"\\n{name}\")\n","    print(\"-\" * len(name))\n","    print(f\"Annualized Mean:       {stats['Mean']:.2%}\")\n","    print(f\"Annualized Volatility: {stats['Volatility']:.2%}\")\n","    print(f\"Sharpe Ratio:          {stats['Sharpe']:.3f}\")"],"metadata":{"id":"4LBNnYIJMVDd","executionInfo":{"status":"ok","timestamp":1786995236480,"user_tz":300,"elapsed":44,"user":{"displayName":"Owakamare Princewill","userId":"11698501470093797192"}}},"execution_count":10,"outputs":[]},{"cell_type":"code","source":["in_sample = df[\n","    df[\"Date\"] <= \"2021-12-31\"\n","].copy()\n","\n","out_of_sample = df[\n","    df[\"Date\"] >= \"2022-01-01\"\n","].copy()\n","\n","traditional_returns = in_sample[TRADITIONAL_ASSETS]\n","\n","tangency_6_weights = tangency_weights(\n","    traditional_returns\n",")\n","\n","tangency_6_returns = portfolio_returns(\n","    traditional_returns,\n","    tangency_6_weights\n",")\n","\n","equal_weights = np.repeat(1 / len(ASSETS), len(ASSETS))\n","\n","returns_6040_is = (\n","    0.60 * in_sample[\"SPY\"] +\n","    0.40 * in_sample[\"IEF\"])\n","\n","equal_weight_returns = portfolio_returns(\n","    df[ASSETS],\n","    equal_weights\n",")\n","\n","returns_6040 = (\n","    0.60 * df[\"SPY\"] +\n","    0.40 * df[\"IEF\"]\n",")"],"metadata":{"id":"Sur-S9mUN3K5","executionInfo":{"status":"ok","timestamp":1786995961194,"user_tz":300,"elapsed":42,"user":{"displayName":"Owakamare Princewill","userId":"11698501470093797192"}}},"execution_count":17,"outputs":[]},{"cell_type":"code","source":["#Question 4 (Adding BTC)\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"4. A NEW ASSET CLASS: BTC\")\n","print(\"=\" * 70)\n","\n","all_returns_is = in_sample[ASSETS]\n","\n","tangency_7_weights = tangency_weights(\n","    all_returns_is\n",")\n","\n","print(\"\\n4.1 Tangency Portfolio Weights Including BTC\")\n","\n","print(\n","    tangency_7_weights.to_frame(\n","        name=\"Weight\"\n","    ).to_string(\n","        float_format=lambda x: f\"{x:.4f}\"\n","    )\n",")\n","\n","print(\n","    f\"\\nBTC allocation: \"\n","    f\"{tangency_7_weights['BTC']:.2%}\"\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 4.2 BTC statistics through 2021\n","# ------------------------------------------------------------\n","\n","btc_mean = annualized_mean(\n","    in_sample[\"BTC\"]\n",")\n","\n","btc_vol = annualized_volatility(\n","    in_sample[\"BTC\"]\n",")\n","\n","btc_sharpe = sharpe_ratio(\n","    in_sample[\"BTC\"]\n",")\n","\n","btc_correlations = (\n","    in_sample[ASSETS]\n","    .corr()[\"BTC\"]\n","    .drop(\"BTC\")\n",")\n","\n","print(\"\\n4.2 BTC Through-2021 Statistics\")\n","\n","print(\n","    f\"BTC annualized mean: \"\n","    f\"{btc_mean:.2%}\"\n",")\n","\n","print(\n","    f\"BTC annualized volatility: \"\n","    f\"{btc_vol:.2%}\"\n",")\n","\n","print(\n","    f\"BTC Sharpe: \"\n","    f\"{btc_sharpe:.3f}\"\n",")\n","\n","print(\"\\nBTC correlations:\")\n","print(\n","    btc_correlations.to_frame(\n","        name=\"Correlation with BTC\"\n","    ).to_string(\n","        float_format=lambda x: f\"{x:.3f}\"\n","    )\n",")\n","\n","print(\"\\n The optimizer gives BTC a moderate allocation rather than a very large one because it considers both BTC's expected return and its risk and diversification benefits.\")\n","print(\"\\n Through 2021, BTC had a very high avg. return making the optimizer want to hold it and increasing its weight. However, its very high volatility limited how much the optimizer wants to allocate to it.\")\n","print(\"\\n BTC also had relatively low correlations with the other assets hence resultant diversification benefits\")\n","\n","# ------------------------------------------------------------\n","# 4.3 BTC allocation analysis\n","# ------------------------------------------------------------\n","\n","print(\"\\n4.3 BTC Allocation Discussion\")\n","\n","print(\"\\n No. It makes a misguided strong assumption based on BTC’s unusually strong historical return through 2021, while the optimizer assumes that this historical mean is a reasonable estimate of its future mean\")\n","print(\"\\n To justify the allocation, I would have to believe that BTC’s future expected return remains sufficiently high to compensate for its very high volatility, while its relatively low correlations with the other assets continue to provide diversification benefits. In particular, I would need to believe that BTC can continue generating a substantially positive expected return.\")\n","print(\"\\n This needn't necessarily be the extremely high historical return, but high enough that its risk-adjusted return remains attractive.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nrB4rEmwQFF-","executionInfo":{"status":"ok","timestamp":1787003574219,"user_tz":300,"elapsed":50,"user":{"displayName":"Owakamare Princewill","userId":"11698501470093797192"}},"outputId":"4967f35c-36ac-4074-8218-9ba43b9a5067"},"execution_count":21,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","\n","======================================================================\n","4. A NEW ASSET CLASS: BTC\n","======================================================================\n","\n","4.1 Tangency Portfolio Weights Including BTC\n","     Weight\n","SPY  2.0234\n","VEA -1.1129\n","IEF  1.0088\n","HYG -1.3027\n","GLD  0.2892\n","USO -0.0566\n","BTC  0.1507\n","\n","BTC allocation: 15.07%\n","\n","4.2 BTC Through-2021 Statistics\n","BTC annualized mean: 111.38%\n","BTC annualized volatility: 80.92%\n","BTC Sharpe: 1.376\n","\n","BTC correlations:\n","     Correlation with BTC\n","SPY                 0.140\n","VEA                 0.213\n","IEF                 0.013\n","HYG                 0.067\n","GLD                 0.163\n","USO                 0.108\n","\n"," The optimizer gives BTC a moderate allocation rather than a very large one because it considers both BTC's expected return and its risk and diversification benefits.\n","\n"," Through 2021, BTC had a very high avg. return making the optimizer want to hold it and increasing its weight. However, its very high volatility limited how much the optimizer wants to allocate to it.\n","\n"," BTC also had relatively low correlations with the other assets hence resultant diversification benefits\n","\n","4.3 BTC Allocation Discussion\n","\n"," No. It makes a misguided strong assumption based on BTC’s unusually strong historical return through 2021, while the optimizer assumes that this historical mean is a reasonable estimate of its future mean\n","\n"," To justify the allocation, I would have to believe that BTC’s future expected return remains sufficiently high to compensate for its very high volatility, while its relatively low correlations with the other assets continue to provide diversification benefits. In particular, I would need to believe that BTC can continue generating a substantially positive expected return.\n","\n"," This needn't necessarily be the extremely high historical return, but high enough that its risk-adjusted return remains attractive.\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# 5. OUT OF SAMPLE\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"5. OUT OF SAMPLE\")\n","print(\"=\" * 70)\n","\n","\n","# ------------------------------------------------------------\n","# 5.1 Hold weights fixed and evaluate 2022 onward\n","# ------------------------------------------------------------\n","\n","# Tangency ex-BTC\n","tangency_6_oos_returns = portfolio_returns(\n","    out_of_sample[TRADITIONAL_ASSETS],\n","    tangency_6_weights\n",")\n","\n","\n","# Tangency with BTC\n","tangency_7_oos_returns = portfolio_returns(\n","    out_of_sample[ASSETS],\n","    tangency_7_weights\n",")\n","\n","\n","# Equal weight\n","equal_weight_oos_returns = portfolio_returns(\n","    out_of_sample[ASSETS],\n","    equal_weights\n",")\n","\n","\n","# 60/40\n","returns_6040_oos = (\n","    0.60 * out_of_sample[\"SPY\"] +\n","    0.40 * out_of_sample[\"IEF\"]\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Performance table\n","# ------------------------------------------------------------\n","\n","section_5_stats = pd.DataFrame({\n","    \"Tangency (ex-BTC)\": portfolio_stats(\n","        tangency_6_oos_returns\n","    ),\n","\n","    \"Tangency (with BTC)\": portfolio_stats(\n","        tangency_7_oos_returns\n","    ),\n","\n","    \"Equal Weight\": portfolio_stats(\n","        equal_weight_oos_returns\n","    ),\n","\n","    \"60/40\": portfolio_stats(\n","        returns_6040_oos\n","    )\n","}).T\n","\n","print(\"\\n5.1 Out-of-Sample Performance\")\n","print(\n","    section_5_stats.to_string(\n","        float_format=lambda x: f\"{x:.4f}\"\n","    )\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 5.2 Compare in-sample and out-of-sample rankings\n","# ------------------------------------------------------------\n","\n","# In-sample returns for four portfolios\n","\n","tangency_6_is_returns = tangency_6_returns\n","\n","tangency_7_is_returns = portfolio_returns(\n","    in_sample[ASSETS],\n","    tangency_7_weights\n",")\n","\n","equal_weight_is_returns = portfolio_returns(\n","    in_sample[ASSETS],\n","    equal_weights\n",")\n","\n","\n","in_sample_ranking = pd.Series({\n","    \"Tangency (ex-BTC)\": sharpe_ratio(\n","        tangency_6_is_returns\n","    ),\n","\n","    \"Tangency (with BTC)\": sharpe_ratio(\n","        tangency_7_is_returns\n","    ),\n","\n","    \"Equal Weight\": sharpe_ratio(\n","        equal_weight_is_returns\n","    ),\n","\n","    \"60/40\": sharpe_ratio(\n","        returns_6040_is\n","    )\n","}).sort_values(\n","    ascending=False\n",")\n","\n","\n","out_sample_ranking = pd.Series({\n","    \"Tangency (ex-BTC)\": sharpe_ratio(\n","        tangency_6_oos_returns\n","    ),\n","\n","    \"Tangency (with BTC)\": sharpe_ratio(\n","        tangency_7_oos_returns\n","    ),\n","\n","    \"Equal Weight\": sharpe_ratio(\n","        equal_weight_oos_returns\n","    ),\n","\n","    \"60/40\": sharpe_ratio(\n","        returns_6040_oos\n","    )\n","}).sort_values(\n","    ascending=False\n",")\n","\n","\n","print(\"\\n5.2 In-Sample Sharpe Ranking\")\n","print(\n","    in_sample_ranking.to_frame(\n","        name=\"Sharpe\"\n","    ).to_string(\n","        float_format=lambda x: f\"{x:.3f}\"\n","    )\n",")\n","\n","\n","print(\"\\n5.2 Out-of-Sample Sharpe Ranking\")\n","print(\n","    out_sample_ranking.to_frame(\n","        name=\"Sharpe\"\n","    ).to_string(\n","        float_format=lambda x: f\"{x:.3f}\"\n","    )\n",")\n","print(\"\\n The tangency portfolio excluding BTC. It had the highest out-of-sample Sharpe ratio and avoided relying on the extremely high historical BTC return that drove the BTC allocation.\")\n","\n","# ------------------------------------------------------------\n","# 5.3 OOS interpretation\n","# ------------------------------------------------------------\n","\n","print(\"\\n5.3 Best Out-of-Sample Portfolio\")\n","\n","best_oos = out_sample_ranking.index[0]\n","\n","print(\n","    f\"The highest out-of-sample Sharpe ratio belongs to: \"\n","    f\"{best_oos}\"\n",")\n","\n","print(\n","    \"\\nThis is only one out-of-sample period, so it does not \"\n","    \"provide definitive evidence that the optimizer works.\"\n",")\n","\n","print(\"\\n The out-of-sample results partially vindicate the optimizer, but do not provide strong evidence that it works reliably.\")\n","print(\"\\n The tangency portfolio excluding BTC had the highest out-of-sample Sharpe ratio (0.954), which is encouraging.\")\n","print(\"\\n However, the optimizer's performance was not overwhelmingly better than the simple equal-weight portfolio, which had a Sharpe ratio of 0.849.\")\n","print(\"\\n More importantly, the out-of-sample period is only one relatively short period of about 4½ years. A single test window can be heavily influenced by the particular market conditions during that period.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"tK8pbPOTQK86","executionInfo":{"status":"ok","timestamp":1787003798931,"user_tz":300,"elapsed":24,"user":{"displayName":"Owakamare Princewill","userId":"11698501470093797192"}},"outputId":"20a034ce-7c9d-4c2a-f164-087859c59d51"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","\n","======================================================================\n","5. OUT OF SAMPLE\n","======================================================================\n","\n","5.1 Out-of-Sample Performance\n","                      Mean  Volatility  Sharpe\n","Tangency (ex-BTC)   0.1938      0.2031  0.9540\n","Tangency (with BTC) 0.1769      0.2238  0.7905\n","Equal Weight        0.1052      0.1239  0.8491\n","60/40               0.0499      0.1090  0.4575\n","\n","5.2 In-Sample Sharpe Ranking\n","                     Sharpe\n","Tangency (with BTC)   2.225\n","Tangency (ex-BTC)     1.824\n","Equal Weight          1.213\n","60/40                 1.003\n","\n","5.2 Out-of-Sample Sharpe Ranking\n","                     Sharpe\n","Tangency (ex-BTC)     0.954\n","Equal Weight          0.849\n","Tangency (with BTC)   0.791\n","60/40                 0.458\n","\n"," The tangency portfolio excluding BTC. It had the highest out-of-sample Sharpe ratio and avoided relying on the extremely high historical BTC return that drove the BTC allocation.\n","\n","5.3 Best Out-of-Sample Portfolio\n","The highest out-of-sample Sharpe ratio belongs to: Tangency (ex-BTC)\n","\n","This is only one out-of-sample period, so it does not provide definitive evidence that the optimizer works.\n","\n"," The out-of-sample results partially vindicate the optimizer, but do not provide strong evidence that it works reliably.\n","\n"," The tangency portfolio excluding BTC had the highest out-of-sample Sharpe ratio (0.954), which is encouraging.\n","\n"," However, the optimizer's performance was not overwhelmingly better than the simple equal-weight portfolio, which had a Sharpe ratio of 0.849.\n","\n"," More importantly, the out-of-sample period is only one relatively short period of about 4½ years. A single test window can be heavily influenced by the particular market conditions during that period.\n"]}]},{"cell_type":"code","source":["# ============================================================\n","# 6. FRAGILITY\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"6. FRAGILITY\")\n","print(\"=\" * 70)\n","\n","\n","# ------------------------------------------------------------\n","# 6.1 Rolling 3-year tangency weights\n","# ------------------------------------------------------------\n","\n","rolling_weights = []\n","\n","for end_idx in range(\n","    WEEKS_IN_3_YEARS - 1,\n","    len(df)\n","):\n","\n","    # 156-week window\n","    window = df.iloc[\n","        end_idx - WEEKS_IN_3_YEARS + 1 :\n","        end_idx + 1\n","    ]\n","\n","    window_returns = window[ASSETS]\n","\n","    weights = tangency_weights(\n","        window_returns\n","    )\n","\n","    row = {\n","        \"Date\": df.iloc[end_idx][\"Date\"]\n","    }\n","\n","    for asset in ASSETS:\n","        row[asset] = weights[asset]\n","\n","    rolling_weights.append(row)\n","\n","\n","rolling_weights = pd.DataFrame(\n","    rolling_weights\n",")\n","\n","rolling_weights = rolling_weights.set_index(\n","    \"Date\"\n",")\n","\n","\n","print(\"\\n6.1 Rolling 3-Year Tangency Weights\")\n","print(\n","    rolling_weights.head()\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Plot rolling weights\n","# ------------------------------------------------------------\n","\n","plt.figure(figsize=(14, 7))\n","\n","for asset in ASSETS:\n","    plt.plot(\n","        rolling_weights.index,\n","        rolling_weights[asset],\n","        label=asset\n","    )\n","\n","plt.axhline(\n","    0,\n","    linewidth=1\n",")\n","\n","plt.title(\n","    \"Rolling 3-Year Tangency Portfolio Weights\"\n",")\n","\n","plt.xlabel(\"Date\")\n","plt.ylabel(\"Portfolio Weight\")\n","\n","plt.legend(\n","    ncol=4\n",")\n","\n","plt.grid(\n","    alpha=0.3\n",")\n","\n","plt.tight_layout()\n","\n","plt.show()\n","\n","\n","# ------------------------------------------------------------\n","# Optional: plot each asset separately\n","# ------------------------------------------------------------\n","\n","for asset in ASSETS:\n","\n","    plt.figure(figsize=(12, 5))\n","\n","    plt.plot(\n","        rolling_weights.index,\n","        rolling_weights[asset]\n","    )\n","\n","    plt.axhline(\n","        0,\n","        linewidth=1\n","    )\n","\n","    plt.title(\n","        f\"Rolling 3-Year Tangency Weight: {asset}\"\n","    )\n","\n","    plt.xlabel(\"Date\")\n","    plt.ylabel(\"Weight\")\n","\n","    plt.grid(\n","        alpha=0.3\n","    )\n","\n","    plt.tight_layout()\n","\n","    plt.show()\n","\n","\n","# ============================================================\n","# 6.2 TWO SUBSAMPLES\n","# ============================================================\n","\n","# ------------------------------------------------------------\n","# 2017-2019\n","# ------------------------------------------------------------\n","\n","period_2017_2019 = df[\n","    (df[\"Date\"] >= \"2017-01-01\") &\n","    (df[\"Date\"] <= \"2019-12-31\")\n","].copy()\n","\n","\n","# ------------------------------------------------------------\n","# 2020-2021\n","# ------------------------------------------------------------\n","\n","period_2020_2021 = df[\n","    (df[\"Date\"] >= \"2020-01-01\") &\n","    (df[\"Date\"] <= \"2021-12-31\")\n","].copy()\n","\n","\n","# ------------------------------------------------------------\n","# Calculate tangency weights\n","# ------------------------------------------------------------\n","\n","weights_2017_2019 = tangency_weights(\n","    period_2017_2019[ASSETS]\n",")\n","\n","weights_2020_2021 = tangency_weights(\n","    period_2020_2021[ASSETS]\n",")\n","\n","\n","# ------------------------------------------------------------\n","# Side-by-side comparison\n","# ------------------------------------------------------------\n","\n","subsample_weights = pd.DataFrame({\n","    \"2017-2019\": weights_2017_2019,\n","    \"2020-2021\": weights_2020_2021\n","})\n","\n","print(\"\\n6.2 Tangency Weights by Subsample\")\n","\n","print(\n","    subsample_weights.to_string(\n","        float_format=lambda x: f\"{x:.4f}\"\n","    )\n",")\n","\n","\n","# ------------------------------------------------------------\n","# 6.3 Fragility analysis\n","# ------------------------------------------------------------\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"6.3 FRAGILITY DISCUSSION\")\n","print(\"=\" * 70)\n","\n","print(\n","    \"\"\"\n","The expected return estimates are generally the bigger\n","problem than the covariance estimates.\n","\n","Expected returns are very noisy and difficult to estimate.\n","Small changes in estimated means can cause very large\n","changes in tangency weights.\n","\n","The covariance matrix is also estimated rather than known,\n","but covariance estimates tend to be more stable than\n","expected return estimates.\n","\n","The rolling 3-year weights demonstrate this instability:\n","small changes in the estimation window can produce enormous\n","long and short positions.\n","\n","This is why practitioners often constrain portfolio weights, limit or prohibit short selling,\n","shrink expected returns toward reasonable values, shrink or regularize covariance estimates, use robust optimization\n","or fall back on simple rules such as equal weighting or 60/40.\n","\n","The mean-variance mathematics is exact conditional on the\n","inputs. The problem is that the inputs themselves are\n","estimated with substantial error.\n","\"\"\"\n",")\n","\n","\n","# ============================================================\n","# ADDITIONAL SUMMARY TABLES\n","# ============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"FINAL SUMMARY\")\n","print(\"=\" * 70)\n","\n","\n","# ------------------------------------------------------------\n","# Full-sample asset statistics\n","# ------------------------------------------------------------\n","\n","print(\"\\nFull-Sample Asset St